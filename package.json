{
  "name": "airreps",
  "version": "1.0.0",
  "description": "The AirReps Repository containing the Ultimate Guide and other resources!",
  "license": "GPL-3.0-or-later",
  "author": "AirReps",
  "homepage": "https://github.com/AirPodsReplicas/AirReps#readme",
  "repository": "https://github.com/AirPodsReplicas/AirReps.git",
  "bugs": {
    "url": "https://github.com/AirPodsReplicas/AirReps/issues"
  },
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "bun run generate-og && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "generate-og": "node scripts/generate-og-images.mjs",
    "analytics:routes": "bun scripts/guide-analytics/generate-allowed-routes.ts",
    "lint": "biome check --files-ignore-unknown=true --diagnostic-level=error --no-errors-on-unmatched docs scripts",
    "lint:fix": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true docs scripts"
  },
  "dependencies": {
    "vitepress": "^2.0.0-alpha.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@resvg/resvg-js": "^2.6.2",
    "fs-extra": "^11.4.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "openai": "^7.43.0",
    "satori": "^0.62.0",
    "satori-html": "^0.3.2",
    "ultracite": "^8.0.2",
    "vite": "^8.3.5"
  }
}